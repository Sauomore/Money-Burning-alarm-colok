# 复制成 keystore.properties 并填入你自己的密钥库信息。
#
# keystore.properties 与 keystore/ 都已被 .gitignore 排除，不会进仓库。
# 密钥库文件千万别丢 —— 丢了就没法给已经装了旧版的用户推送更新
# （Android 只允许签名一致的包覆盖安装）。
#
# 生成一个新密钥库：
#   keytool -genkeypair -v -keystore keystore/burnalarm.jks \
#     -alias burnalarm -keyalg RSA -keysize 2048 -validity 10000
#
# 不创建这个文件也能编译，只是 release 包会是未签名的。

storeFile=keystore/burnalarm.jks
storePassword=CHANGE_ME
keyAlias=burnalarm
keyPassword=CHANGE_ME
