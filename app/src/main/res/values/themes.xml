<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      父主题必须是 AppCompat 的：Activity 换成了 AppCompatActivity（为了 setApplicationLocales），
      它会在 onCreate 里校验主题，用平台主题会直接抛
      "You need to use a Theme.AppCompat theme (or descendant) with this activity"。
      实际界面全部由 Compose Material3 绘制，这里只管窗口底色和状态栏。
    -->
    <style name="Theme.BurnAlarm" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- 响铃页：深色背景，减少夜里刺眼 -->
    <style name="Theme.BurnAlarm.Ring" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF0B0B12</item>
        <item name="android:statusBarColor">#FF0B0B12</item>
        <item name="android:navigationBarColor">#FF0B0B12</item>
    </style>
</resources>
